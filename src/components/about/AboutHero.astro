---
import { Image } from 'astro:assets';
import heroImage from '../../assets/img/about-page-img-05.jpg';
---

<section class="bg-white dark:bg-slate-950 py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Encabezado -->
    <div class="mb-14 md:mb-20">
      <span
        class="text-primary font-bold tracking-[0.25em] uppercase text-xs mb-4 block"
      >
        Sobre mí
      </span>

      <h1
        class="text-5xl md:text-7xl font-black tracking-tight text-slate-900 dark:text-white"
      >
        Presentación
      </h1>
    </div>

    <!-- Información personal -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
    >

      <!-- Foto / Avatar -->
      <div>
        <div class="relative overflow-hidden rounded-lg">
          <Image
            src={heroImage}
            alt="Foto de presentación de Maicol Orti"
            class="w-full aspect-[4/5] object-cover"
            loading="eager"
            fetchpriority="high"
            layout="constrained"
            width={800}
            height={1000}
            format="webp"
            fit="cover"
            quality={85}
          />

          <div
            class="absolute inset-0 border-[16px] border-white/10 pointer-events-none"
          ></div>
        </div>
      </div>

      <!-- Datos -->
      <div>
        <span
          class="text-primary font-bold uppercase tracking-[0.2em] text-xs mb-4 block"
        >
          Estudiante
        </span>

        <h2
          class="text-4xl md:text-6xl font-black tracking-tight text-slate-900 dark:text-white mb-8"
        >
          Maicol Orti
        </h2>

        <div class="space-y-5 mb-10">

          <!-- Programa -->
          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-500 mb-1"
            >
              Programa
            </p>

            <p class="text-lg text-slate-800 dark:text-slate-200">
              Ingeniería de Sistemas
            </p>
          </div>

          <!-- Universidad -->
          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-500 mb-1"
            >
              Universidad
            </p>

            <p class="text-lg text-slate-800 dark:text-slate-200">
              Universidad El Bosque
            </p>
          </div>

          <!-- Asignatura -->
          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-500 mb-1"
            >
              Asignatura
            </p>

            <p class="text-lg text-slate-800 dark:text-slate-200">
              Bases de Datos 1
            </p>
          </div>

        </div>

        <!-- Descripción -->
        <p
          class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed font-light"
        >
          Soy estudiante de Ingeniería de Sistemas y este E-portafolio
          representa mi proceso de aprendizaje durante la asignatura
          Bases de Datos 1. Aquí recopilo las actividades, ejercicios,
          evidencias y proyectos desarrollados a lo largo del semestre.
        </p>
      </div>

    </div>

    <!-- Video -->
    <div class="mt-24 md:mt-32">

      <!-- Encabezado del video -->
      <div class="max-w-3xl mb-10">
        <span
          class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-4 block"
        >
          Video
        </span>

        <h2
          class="text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white mb-5"
        >
          Video de presentación
        </h2>

        <p
          class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed"
        >
          Una breve presentación sobre quién soy, mis intereses y la
          importancia de Bases de Datos 1 en mi formación profesional.
        </p>
      </div>

      <!-- Video de YouTube -->
      <div
        class="aspect-video w-full max-w-5xl overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm"
      >
        <iframe
          class="w-full h-full"
          src="https://www.youtube.com/embed/V8ESyjMMjr0"
          title="Video de presentación de Maicol Orti"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

    </div>

  </div>
</section>