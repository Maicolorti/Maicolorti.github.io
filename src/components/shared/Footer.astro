---
import Container from './Container.astro';

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800"
>
  <Container>
    <div class="py-16 md:py-20">

      <!-- Main Footer -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16"
      >

        <!-- Identity -->
        <div>
          <a
            href="/"
            class="inline-block mb-5"
          >
            <span
              class="text-xl font-black text-slate-900 dark:text-white tracking-tight"
            >
              MAICOL ORTI
            </span>
          </a>

          <p
            class="text-slate-600 dark:text-slate-400 text-sm font-light leading-relaxed max-w-sm"
          >
            E-portafolio académico desarrollado para registrar
            las evidencias, actividades y proyectos realizados
            durante la asignatura Bases de Datos 1.
          </p>
        </div>

        <!-- Navigation -->
        <div>
          <h2
            class="text-slate-900 dark:text-slate-100 text-xs font-bold uppercase tracking-widest mb-6"
          >
            Navegación
          </h2>

          <ul class="space-y-3">
            <li>
              <a
                href="/"
                class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-sm"
              >
                Inicio
              </a>
            </li>

            <li>
              <a
                href="/about"
                class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-sm"
              >
                Presentación
              </a>
            </li>

            <li>
              <a
                href="/projects"
                class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-sm"
              >
                Evidencias
              </a>
            </li>
          </ul>
        </div>

        <!-- Academic Information -->
        <div>
          <h2
            class="text-slate-900 dark:text-slate-100 text-xs font-bold uppercase tracking-widest mb-6"
          >
            Información académica
          </h2>

          <div class="space-y-3">
            <p
              class="text-slate-600 dark:text-slate-400 text-sm"
            >
              Universidad El Bosque
            </p>

            <p
              class="text-slate-600 dark:text-slate-400 text-sm"
            >
              Ingeniería de Sistemas
            </p>

            <p
              class="text-slate-600 dark:text-slate-400 text-sm"
            >
              Bases de Datos 1
            </p>
          </div>
        </div>

      </div>

      <!-- Bottom Footer -->
      <div
        class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4"
      >
        <p
          class="text-slate-500 dark:text-slate-500 text-[10px] uppercase tracking-widest font-medium text-center md:text-left"
        >
          © {currentYear} Maicol Orti. E-portafolio académico.
        </p>

        <p
          class="text-slate-500 dark:text-slate-500 text-[10px] uppercase tracking-widest font-medium"
        >
          Bases de Datos 1
        </p>
      </div>

    </div>
  </Container>
</footer>