---
import Container from '../shared/Container.astro';
import Icon from '../shared/Icon.astro';

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/') {
    return currentPath === '/';
  }

  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header
  class="w-full bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800"
>
  <Container>
    <div class="h-20 flex items-center justify-between">

      <!-- Logo / Nombre -->
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label="Ir al inicio"
      >
        <div
          class="w-9 h-9 bg-primary rotate-45 rounded-sm transition-transform group-hover:rotate-[135deg]"
        ></div>

        <div class="flex flex-col leading-tight">
          <span
            class="text-lg font-black text-slate-900 dark:text-white tracking-tight"
          >
            MAICOL ORTI
          </span>

          <span
            class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-[0.18em]"
          >
            E-portafolio · BD1
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center gap-10"
        aria-label="Navegación principal"
      >
        <a
          href="/"
          class:list={[
            "text-sm font-semibold transition-colors",
            isActive('/')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
          ]}
        >
          Inicio
        </a>

        <a
          href="/about"
          class:list={[
            "text-sm font-semibold transition-colors",
            isActive('/about')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
          ]}
        >
          Presentación
        </a>

        <a
          href="/projects"
          class:list={[
            "text-sm font-semibold transition-colors",
            isActive('/projects')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
          ]}
        >
          Evidencias
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden p-2 rounded-md text-slate-600 dark:text-slate-400 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={24} />
      </button>

    </div>

    <!-- Mobile Navigation -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-6 border-t border-slate-200 dark:border-slate-800"
      aria-label="Navegación móvil"
    >
      <div class="flex flex-col pt-4">

        <a
          href="/"
          class:list={[
            "py-3 text-sm font-semibold transition-colors",
            isActive('/')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary"
          ]}
        >
          Inicio
        </a>

        <a
          href="/about"
          class:list={[
            "py-3 text-sm font-semibold transition-colors",
            isActive('/about')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary"
          ]}
        >
          Presentación
        </a>

        <a
          href="/projects"
          class:list={[
            "py-3 text-sm font-semibold transition-colors",
            isActive('/projects')
              ? "text-primary"
              : "text-slate-600 dark:text-slate-400 hover:text-primary"
          ]}
        >
          Evidencias
        </a>

      </div>
    </nav>
  </Container>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');

      menuButton.setAttribute(
        'aria-expanded',
        String(!isOpen)
      );

      menuButton.setAttribute(
        'aria-label',
        isOpen ? 'Abrir menú' : 'Cerrar menú'
      );
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Abrir menú');
      });
    });
  }
</script>