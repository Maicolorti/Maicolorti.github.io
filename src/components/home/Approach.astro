---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
import Icon from '../shared/Icon.astro';
import { Image } from 'astro:assets';

import approachImage from '../../assets/img/home-page-img-02.jpg';
---

<section class="bg-slate-100 dark:bg-background-dark/50 py-24 md:py-40">
  <Container>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-32 items-center">

      <!-- Image -->
      <div class="order-2 lg:order-1">
        <div class="relative overflow-hidden rounded group">

          <Image
            src={approachImage}
            alt="Representación visual del aprendizaje y organización de datos"
            class="w-full aspect-square object-cover grayscale group-hover:grayscale-0 transition-all duration-1000"
            loading="lazy"
            decoding="async"
            layout="constrained"
            width={800}
            height={800}
            format="webp"
            fit="cover"
            widths={[400, 600, 800, 1024]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={80}
          />

          <div
            class="absolute inset-0 border-[20px] border-white/10 pointer-events-none"
          ></div>

        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2">

        <span
          class="text-primary font-bold uppercase tracking-[0.3em] text-xs mb-6 block"
        >
          Sobre el portafolio
        </span>

        <h2
          class="text-5xl md:text-7xl font-black tracking-tighter uppercase leading-[0.9] mb-10 text-slate-900 dark:text-white"
        >
          Aprender <br />Construyendo
        </h2>

        <div class="space-y-8 max-w-lg">

          <p
            class="text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed font-light"
          >
            Este E-portafolio reúne las evidencias, ejercicios y proyectos
            desarrollados durante la asignatura Bases de Datos 1, mostrando
            mi proceso de aprendizaje desde el modelado y la normalización
            hasta la implementación mediante SQL.
          </p>

          <!-- Features -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6">

            <!-- Aprendizaje -->
            <div class="flex flex-col gap-2">

              <Icon
                name="database"
                size={32}
                class="text-primary"
              />

              <span
                class="font-bold uppercase tracking-widest text-sm text-slate-700 dark:text-slate-200 block"
              >
                Aprendizaje
              </span>

              <p
                class="text-xs text-slate-600 dark:text-slate-300 uppercase tracking-wider"
              >
                Desarrollo progresivo de conceptos y habilidades.
              </p>

            </div>

            <!-- Evidencias -->
            <div class="flex flex-col gap-2">

              <Icon
                name="file-check"
                size={32}
                class="text-primary"
              />

              <span
                class="font-bold uppercase tracking-widest text-sm text-slate-700 dark:text-slate-200 block"
              >
                Evidencias
              </span>

              <p
                class="text-xs text-slate-600 dark:text-slate-300 uppercase tracking-wider"
              >
                Registro de actividades, ejercicios y proyectos realizados.
              </p>

            </div>

          </div>

          <!-- CTA -->
          <div class="pt-4">

            <Button
              href="/about"
              variant="outline"
              size="lg"
            >
              Conoce mi presentación
            </Button>

          </div>

        </div>
      </div>

    </div>

  </Container>
</section>