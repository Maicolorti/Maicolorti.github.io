---
import Container from '../shared/Container.astro';
---

<Container>
  <div class="mb-12 md:mb-16">

    <span
      class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-4 block"
    >
      Bases de Datos 1
    </span>

    <h1
      class="text-slate-900 dark:text-slate-100 text-5xl md:text-6xl font-black leading-tight tracking-tight mb-5"
    >
      Evidencias
    </h1>

    <p
      class="text-slate-500 dark:text-slate-400 text-lg md:text-xl max-w-3xl font-light leading-relaxed"
    >
      Registro de actividades, ejercicios y proyectos desarrollados
      durante la asignatura Bases de Datos 1, organizados según las
      diferentes etapas de mi proceso de aprendizaje.
    </p>

  </div>
</Container>