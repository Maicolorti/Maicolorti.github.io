---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  location: string;
  year: string;
  category: string;
  image: ImageMetadata | string;
  alt: string;
  href?: string;
}

const {
  title,
  location,
  year,
  category,
  image,
  alt,
  href
} = Astro.props;

// @ts-ignore
const isSVG =
  typeof image !== 'string' &&
  image?.format === 'svg';

const isRemoteImage =
  typeof image === 'string' &&
  (image.startsWith('http') || image.startsWith('https'));
---

<div
  class:list={[
    "group relative",
    href ? "cursor-pointer" : "cursor-default"
  ]}
>
  <!-- Enlace sobre toda la tarjeta -->
  {
    href && (
      <a
        href={href}
        class="absolute inset-0 z-30"
        aria-label={`Ver evidencia de ${title}`}
      ></a>
    )
  }

  <!-- Imagen -->
  <div
    class="relative overflow-hidden mb-4 bg-slate-200 dark:bg-slate-800 rounded flex items-center justify-center"
  >
    {
      typeof image === 'string' ? (
        <img
          src={image}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width={800}
          height={600}
        />
      ) : isSVG ? (
        <img
          src={image.src}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width={800}
          height={600}
        />
      ) : (
        <Image
          src={image}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          widths={[240, 540, 720, image.width]}
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.width}px`}
        />
      )
    }
  </div>

  <!-- Información -->
  <div class="flex justify-between items-start">
    <div>
      <h3
        class:list={[
          "text-slate-900 dark:text-slate-100 text-lg font-semibold tracking-tight transition-colors",
          href && "group-hover:text-primary"
        ]}
      >
        {title}
      </h3>

      <p
        class="text-slate-500 dark:text-slate-400 text-sm font-light"
      >
        {category} • {location}
      </p>
    </div>

    <span
      class="text-slate-400 text-sm font-medium"
    >
      {year}
    </span>
  </div>
</div>