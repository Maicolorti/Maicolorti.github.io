---
import Container from '../shared/Container.astro';
import ProjectCard from './ProjectCard.astro';

import project1Image from '../../assets/img/projects-page-img-01.jpg';
import project2Image from '../../assets/img/projects-page-img-02.jpg';
import project3Image from '../../assets/img/projects-page-img-03.jpg';
import project4Image from '../../assets/img/projects-page-img-04.jpg';

const projects = [
  {
    title: "Modelado",
    category: "Evidencia",
    location: "Bases de Datos 1",
    year: "2026",
    image: project1Image,
    alt: "Evidencias de modelado de bases de datos",
    href: "/projects/modelado"
  },
  {
    title: "Normalización",
    category: "Evidencia",
    location: "Bases de Datos 1",
    year: "2026",
    image: project2Image,
    alt: "Evidencias de normalización de bases de datos",
    href: undefined
  },
  {
    title: "SQL",
    category: "Evidencia",
    location: "Bases de Datos 1",
    year: "2026",
    image: project3Image,
    alt: "Ejercicios y evidencias desarrollados con SQL",
    href: undefined
  },
  {
    title: "Proyecto",
    category: "Evidencia",
    location: "Bases de Datos 1",
    year: "2026",
    image: project4Image,
    alt: "Proyecto desarrollado durante Bases de Datos 1",
    href: undefined
  }
];
---

<Container>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10"
  >
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          category={project.category}
          location={project.location}
          year={project.year}
          image={project.image}
          alt={project.alt}
          href={project.href}
        />
      ))
    }
  </div>
</Container>