---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/home/Navbar.astro';
import Footer from '../../../components/shared/Footer.astro';

const pdfUrl = '/evidencias/modelado/ModeloEntidadRelacion.pdf';
const imageUrl = '/evidencias/modelado/ModeloEntidadRelacion.png';
---

<Layout
  title="Modelado | Bases de Datos 1"
  description="Evidencia de modelado Entidad-Relación desarrollada para la asignatura Bases de Datos 1."
>
  <Navbar />

  <main class="bg-white dark:bg-slate-950">

    <!-- Encabezado -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <a
          href="/projects"
          class="inline-flex items-center text-primary text-sm font-bold uppercase tracking-wider hover:opacity-80 transition-opacity"
        >
          ← Volver a Evidencias
        </a>

        <div class="mt-8 max-w-4xl">

          <span
            class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-4 block"
          >
            Evidencia · Modelado
          </span>

          <h1
            class="text-5xl md:text-7xl font-black tracking-tight text-slate-900 dark:text-white mb-6"
          >
            University Champions League
          </h1>

          <p
            class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed"
          >
            Diseño de un modelo Entidad–Relación para un sistema de información
            encargado de almacenar y organizar las estadísticas del torneo de
            fútbol University Champions League de la Universidad El Bosque.
          </p>

        </div>

      </div>
    </section>

    <!-- Datos -->
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-6">

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-8 border-y border-slate-200 dark:border-slate-800 py-10"
        >

          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2"
            >
              Asignatura
            </p>

            <p class="text-slate-900 dark:text-white font-medium">
              Bases de Datos 1
            </p>
          </div>

          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2"
            >
              Tipo de evidencia
            </p>

            <p class="text-slate-900 dark:text-white font-medium">
              Modelo Entidad–Relación
            </p>
          </div>

          <div>
            <p
              class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2"
            >
              Categoría
            </p>

            <p class="text-slate-900 dark:text-white font-medium">
              Modelado
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- Descripción -->
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-6">

        <div class="max-w-4xl">

          <span
            class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-4 block"
          >
            Actividad
          </span>

          <h2
            class="text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-white mb-6"
          >
            Descripción de la evidencia
          </h2>

          <p
            class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed"
          >
            La actividad consiste en diseñar un modelo Entidad–Relación que
            permita representar la información necesaria para administrar el
            torneo de fútbol. El modelo contempla información relacionada con
            equipos, jugadores, semestres, programas académicos, partidos,
            puntos obtenidos, tarjetas amarillas y rojas, y las posiciones
            de los equipos dentro de la competencia.
          </p>

        </div>

      </div>
    </section>

    <!-- Evidencia visual -->
    <section class="pb-24">
      <div class="max-w-7xl mx-auto px-6">

        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8"
        >

          <div>
            <span
              class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-3 block"
            >
              Evidencia visual
            </span>

            <h2
              class="text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-white"
            >
              Modelo Entidad–Relación
            </h2>
          </div>

          <!-- PDF -->
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center border border-primary text-primary hover:bg-primary hover:text-white px-5 py-2.5 rounded text-sm font-bold uppercase tracking-wider transition-colors"
          >
            Ver PDF
          </a>

        </div>

        <!-- Imagen principal -->
        <div
          class="rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900"
        >
          <a
            href={imageUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir modelo Entidad-Relación en tamaño completo"
          >
            <img
              src={imageUrl}
              alt="Modelo Entidad-Relación de University Champions League"
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </a>
        </div>

        <div
          class="mt-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
        >
          <p
            class="text-sm text-slate-500 dark:text-slate-400"
          >
            Haz clic sobre la imagen para visualizar el modelo en tamaño completo.
          </p>

          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-bold text-primary hover:underline"
          >
            Abrir documento PDF →
          </a>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>