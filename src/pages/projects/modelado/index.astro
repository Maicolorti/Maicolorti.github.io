---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/home/Navbar.astro';
import Footer from '../../../components/shared/Footer.astro';

import championsImage from '../../../assets/img/projects-page-img-01.jpg';
import quizImage from '../../../assets/img/projects-page-img-02.jpg';
---

<Layout
  title="Modelado | Bases de Datos 1"
  description="Evidencias de modelado desarrolladas en Bases de Datos 1."
>

<Navbar />

<main class="bg-white dark:bg-slate-950">

  <!-- Encabezado -->
  <section class="py-16 md:py-24">

    <div class="max-w-7xl mx-auto px-6">

      <a
        href="/projects"
        class="text-primary text-sm font-bold uppercase tracking-wider"
      >
        ← Volver a Evidencias
      </a>


      <div class="mt-8 max-w-4xl">

        <span
          class="text-primary font-bold uppercase tracking-[0.25em] text-xs mb-4 block"
        >
          Categoría
        </span>


        <h1
          class="text-5xl md:text-7xl font-black tracking-tight text-slate-900 dark:text-white mb-6"
        >
          Modelado
        </h1>


        <p
          class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed"
        >
          En esta sección se recopilan las actividades relacionadas con el
          diseño conceptual de bases de datos, construcción de modelos
          Entidad–Relación y análisis de requerimientos realizados durante la
          asignatura Bases de Datos 1.
        </p>

      </div>

    </div>

  </section>



  <!-- Evidencias -->
  <section class="pb-24">

    <div class="max-w-7xl mx-auto px-6">


      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">


        <!-- Champions League -->
        <a
          href="/projects/modelado/champions-league"
          class="group"
        >

          <div
            class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 mb-6"
          >

            <img
              src={championsImage.src}
              alt="Modelo Entidad Relación University Champions League"
              class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-700"
            />

          </div>


          <span
            class="text-primary text-xs font-bold uppercase tracking-widest"
          >
            Evidencia 1
          </span>


          <h2
            class="text-3xl font-black text-slate-900 dark:text-white mt-2 mb-3 group-hover:text-primary transition-colors"
          >
            University Champions League
          </h2>


          <p
            class="text-slate-600 dark:text-slate-400 leading-relaxed"
          >
            Diseño de un modelo Entidad–Relación para representar la
            información de un torneo universitario.
          </p>

        </a>



        <!-- Quiz 1 -->
        <a
          href="/projects/modelado/quiz-1"
          class="group"
        >

          <div
            class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 mb-6"
          >

            <img
              src={quizImage.src}
              alt="Quiz 1 Bases de Datos 1"
              class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-700"
            />

          </div>


          <span
            class="text-primary text-xs font-bold uppercase tracking-widest"
          >
            Evidencia 2
          </span>


          <h2
            class="text-3xl font-black text-slate-900 dark:text-white mt-2 mb-3 group-hover:text-primary transition-colors"
          >
            Quiz 1
          </h2>


          <p
            class="text-slate-600 dark:text-slate-400 leading-relaxed"
          >
            Evaluación sobre fundamentos de bases de datos, modelo
            Entidad–Relación y modelo Entidad–Relación Extendido.
          </p>


        </a>


      </div>


    </div>

  </section>


</main>


<Footer />

</Layout>